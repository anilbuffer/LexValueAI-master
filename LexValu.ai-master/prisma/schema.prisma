datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

model Firm {
  id      String  @id @default(uuid())
  name    String
  email   String?
  phone   String?
  address String?
  taxId         String? @map("tax_id")
  require2fa    Boolean @default(false) @map("require_2fa")
  sessionTimeout Int    @default(30) @map("session_timeout")
  dataRetention String  @default("7") @map("data_retention")

  users User[]
  cases Case[]
  documents Document[]
  documentChunks DocumentChunk[]
  auditLogs AuditLog[]
  notifications Notification[]
  timelineEvents TimelineEvent[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("firms")
}

enum Role {
  ADMIN
  MANAGING_PARTNER
  ATTORNEY
  PARALEGAL
}

model User {
  id           String @id @default(uuid())
  firstName    String @map("first_name")
  lastName     String @map("last_name")
  email        String @unique
  phone        String?
  passwordHash String @map("password_hash")

  role Role @default(PARALEGAL)
  isActive Boolean @default(true) @map("is_active")

  firmId String @map("firm_id")
  firm   Firm   @relation(fields: [firmId], references: [id], onDelete: Cascade)

  managingPartnerId String? @map("managing_partner_id")
  managingPartner   User?   @relation("ManagingPartner", fields: [managingPartnerId], references: [id])
  mpSubordinates    User[]  @relation("ManagingPartner")

  attorneyId String? @map("attorney_id")
  attorney   User?   @relation("Attorney", fields: [attorneyId], references: [id])
  attorneySubordinates User[]  @relation("Attorney")

  createdCases Case[] @relation("CaseCreator")
  assignedCases Case[] @relation("CaseAssignees")
  auditLogs    AuditLog[]
  notifications Notification[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Case {
  id           String   @id @default(uuid())
  referenceId  String?  @map("reference_id")
  title        String
  client        String
  clientEmail   String   @map("client_email")
  clientPhone   String   @map("client_phone")
  clientAge     Int      @map("client_age")
  clientGender  String   @map("client_gender")
  clientAddress String   @map("client_address")
  type          String
  dateOfInjury DateTime @map("date_of_injury")
  status       String
  flags        Int?
  customPrompt String?  @map("custom_prompt")
  approvalStatus String @default("PENDING") @map("approval_status")
  rejectionReason String? @map("rejection_reason")
  scanProgress   Int      @default(0) @map("scan_progress")
  scanStage      String   @default("QUEUED") @map("scan_stage")

  firmId String @map("firm_id")
  firm   Firm   @relation(fields: [firmId], references: [id], onDelete: Cascade)

  createdByUserId String? @map("created_by_user_id")
  createdByUser   User?   @relation("CaseCreator", fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  documents Document[]
  assignedUsers User[] @relation("CaseAssignees")
  timelineEvents TimelineEvent[]
  auditLogs    AuditLog[]
  notifications Notification[]

  @@map("cases")
}

model Document {
  id           String   @id @default(uuid())
  fileName     String   @map("file_name")
  s3Key        String   @map("s3_key")
  size         Int
  mimeType     String   @map("mime_type")
  status       String   // "UPLOADED", "PROCESSING", "READY", "FAILED"
  summary      String?
  aiAnalysis   Json?    @map("ai_analysis")

  caseId       String   @map("case_id")
  case         Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  firmId       String   @map("firm_id")
  firm         Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  documentChunks DocumentChunk[]
  timelineEvents TimelineEvent[]

  @@map("documents")
}

model DocumentChunk {
  id         String   @id @default(uuid())
  text       String
  embedding  Unsupported("vector(1024)")
  
  documentId String   @map("document_id")
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  firmId     String   @map("firm_id")
  firm       Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now()) @map("created_at")

  @@map("document_chunks")
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String   // e.g. "USER_LOGIN", "CASE_CREATED"
  details    String   // Description of the action
  
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  firmId     String   @map("firm_id")
  firm       Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)

  caseId     String?  @map("case_id")
  case       Case?    @relation(fields: [caseId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

model Notification {
  id         String   @id @default(uuid())
  message    String
  type       String   // "CASE_CREATED", "CASE_ASSIGNED", "CASE_REJECTED", "INFO"
  isRead     Boolean  @default(false) @map("is_read")
  
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  firmId     String   @map("firm_id")
  firm       Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)

  caseId     String?  @map("case_id")
  case       Case?    @relation(fields: [caseId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now()) @map("created_at")

  @@map("notifications")
}

model TimelineEvent {
  id          String   @id @default(uuid())
  date        DateTime // Parsed date of the event
  title       String
  description String
  
  documentId  String   @map("document_id")
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  caseId      String   @map("case_id")
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  firmId      String   @map("firm_id")
  firm        Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now()) @map("created_at")

  @@map("timeline_events")
}
