{
  "family": "lexvalu-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::445606684295:role/lexvalu-ecs-execution-role",
  "taskRoleArn": "arn:aws:iam::445606684295:role/lexvalu-ecs-task-role",
  "containerDefinitions": [
    {
      "name": "lexvalu",
      "image": "445606684295.dkr.ecr.us-east-1.amazonaws.com/lexvalue/prod:latest",
      "essential": true,
      "portMappings": [{ "containerPort": 3000, "protocol": "tcp" }],
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "AWS_REGION", "value": "us-east-1" },
        { "name": "AWS_S3_BUCKET_NAME", "value": "lexvalue-prod" },
        { "name": "DB_HOST", "value": "lax-value.c0lsgcoogql1.us-east-1.rds.amazonaws.com" },
        { "name": "DB_PORT", "value": "5432" },
        { "name": "DB_NAME", "value": "lexvalue" }
      ],
      "secrets": [
        { "name": "DB_USERNAME", "valueFrom": "arn:aws:secretsmanager:us-east-1:445606684295:secret:rds!db-c4ed7f99-3774-4d72-9a01-8f7db7211454:username::" },
        { "name": "DB_PASSWORD", "valueFrom": "arn:aws:secretsmanager:us-east-1:445606684295:secret:rds!db-c4ed7f99-3774-4d72-9a01-8f7db7211454:password::" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/lexvalu",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "app",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
